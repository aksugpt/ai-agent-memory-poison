# Copy this file to .env and fill it in. Never commit .env (it holds your secret key).
# Which model answers: "groq" (cloud) or "ollama" (local). The UI can also switch per session.
LLM_PROVIDER=groq            # groq | ollama
# Your Groq API key (only needed for the cloud model).
GROQ_API_KEY=''
# The cloud model on Groq.
GROQ_MODEL=openai/gpt-oss-120b
# The local model served by Ollama, and the address of the Ollama server.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
# Gmail search that limits what the email tools can see (the lab's test emails all have LAB in the subject).
EMAIL_SCOPE=subject:LAB
